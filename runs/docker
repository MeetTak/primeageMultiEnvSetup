#!/usr/bin/env bash
set -euo pipefail
brew list colima >/dev/null 2>&1 || brew install colima docker docker-compose docker-buildx
docker context inspect homelab >/dev/null 2>&1 || \
  docker context create homelab --docker "host=ssh://homelab"
colima list 2>/dev/null | grep -q default || \
  { colima start --cpu 2 --memory 2 --disk 30 --vm-type vz && colima stop; }
chmod 700 ~/.ssh; chmod 600 ~/.ssh/config ~/.ssh/config.d/* 2>/dev/null || true
echo "done — run: docker info --format '{{.Name}}'"
