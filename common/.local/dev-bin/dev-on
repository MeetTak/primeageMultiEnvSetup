#!/usr/bin/env bash
# Switch to the dev profile (dev/env overlay on top of common/)
if [[ "${DEV_ENV_MODE:-}" == "dev" && "${1:-}" != "--dry" ]]; then
  echo "You are already in the dev environment (run dev-apply to re-apply)"
  exit 0
fi

DEV_ENV_MODE=dev "${DEV_ENV_ROOT:-$HOME/.personal}/dev-apply" "$@" || exit $?

[[ "${1:-}" == "--dry" ]] || printf "\nRun 'exec zsh' or open a new terminal to apply changes\n"
